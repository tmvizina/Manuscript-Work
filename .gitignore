.DS_Store
__pycache__/
*.pyc
.env

# local demo/run output
/tmp-*/
.tmp-tests/

# book-writer app
node_modules/
.npm-cache/
app/ui/dist/
app/desktop/dist/
packages/core/dist/
# Build output. The installer itself is not tracked: at ~102 MB it exceeds
# GitHub's hard 100 MB file limit, and it is already LZMA-compressed so it
# does not shrink. Its identity lives in docs/windows-release-record.md.
dist/desktop/
app/server/data/
rag/chroma_db/
rag/.venv/

# Embedding model weights, fetched at build time by
# test/packaging/fetch-rag-model.mjs and verified against the checked-in
# manifest.json. Deliberately untracked: ~23 MB of binary would sit in git
# history on every clone forever. manifest.json, LICENSE, and NOTICE stay
# tracked, so the expected bytes remain pinned and attributed.
app/desktop/resources/rag-model/tokenizer.json
app/desktop/resources/rag-model/tokenizer_config.json
app/desktop/resources/rag-model/config.json
app/desktop/resources/rag-model/*.partial

# The weights are tracked deliberately. They are excluded from the installer
# (see electron-builder.yml) because they would push it past GitHub's 100 MB
# file limit, so they are distributed as this separate file and imported by
# the app, which hash-verifies them against the manifest above. At ~23 MB the
# file itself is well under the limit.
!app/desktop/resources/rag-model/model_quantized.onnx
.idea/
