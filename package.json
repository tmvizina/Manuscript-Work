{
  "name": "book-writer-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/server",
    "app/ui",
    "packages/core",
    "app/desktop"
  ],
  "scripts": {
    "typecheck": "npm.cmd run typecheck --workspaces --if-present && npm.cmd exec --workspace app/ui -- tsc --noEmit",
    "test": "npm.cmd exec -- vitest run --config vitest.config.ts",
    "build": "npm.cmd run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
